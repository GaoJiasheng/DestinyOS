# Cloudflare primary: DB (D1), CACHE (KV), RATE_LIMITER, EXPORT_BUCKET and BROWSER are Wrangler bindings.
# Optional local Node development database; D1/Workers use no connection URL.
LOCAL_DATABASE_URL=file:./prisma/local.db
# Auth.js signing secret; generate with openssl rand -base64 32.
AUTH_SECRET=
# Canonical Auth.js origin; Preview uses its isolated deployment URL.
AUTH_URL=https://tianji.gavin.pub
# Only deploy behind the trusted Vercel/Cloudflare proxy.
AUTH_TRUST_HOST=true
# Google OAuth client ID.
AUTH_GOOGLE_ID=
# Google OAuth client secret.
AUTH_GOOGLE_SECRET=
# Cloudflare Email Service EMAIL binding sends account mail; local Node uses a mock.
# Verified sending-domain address (plain address, without display name).
EMAIL_FROM=noreply@mail.gavin.pub
# Sender display name; server-only, non-secret configuration.
EMAIL_FROM_NAME=天机 DestinyOS
# AES-256-GCM keys: v2:<base64 32-byte key>,v1:<old key>; first key writes.
FIELD_ENCRYPTION_KEYS=
# Website payments are disabled by default; Stripe variables below are optional until enabled.
FEATURE_WEB_PAYMENTS=false
# Public App download links; empty means coming soon.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# Stripe secret API key (server only).
STRIPE_SECRET_KEY=
# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Stripe monthly subscription price ID.
STRIPE_PRICE_MONTHLY=
# Stripe lifetime one-time USD 6.99 price ID.
STRIPE_PRICE_LIFETIME=
# Public AdSense publisher ID, e.g. ca-pub-xxxx.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Canonical public production URL; use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://tianji.gavin.pub
# Default language; supported initial locales are zh and en.
NEXT_PUBLIC_DEFAULT_LOCALE=zh
# Reserved runtime LLM polish switch; remains disabled.
FEATURE_LLM_POLISH=false
# Advertisement feature switch (ads integration ships in M4).
FEATURE_ADS=true
# Comma-separated administrator email allowlist (server only).
ADMIN_EMAILS=
# Optional Sentry DSN for monitoring.
SENTRY_DSN=
# Server-only Vercel Cron authentication secret.
CRON_SECRET=

# Optional public browser monitoring DSN (never a server secret).
NEXT_PUBLIC_SENTRY_DSN=

# Enable automatic tax only after activating Stripe Tax in the merchant account.
STRIPE_TAX_ENABLED=false
# RevenueCat REST server key; absent skips manual membership refresh and Stripe sync.
REVENUECAT_SECRET_KEY=
# Optional Stripe app API key for receipt imports; defaults to the server key above.
REVENUECAT_STRIPE_API_KEY=
# RevenueCat integration HMAC signing secret (required for mobile webhook verification).
REVENUECAT_WEBHOOK_SECRET=
# Numeric AdSense slot IDs from the publisher account; absent IDs omit their slots.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_REPORT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_REPORT_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_TODAY=
NEXT_PUBLIC_ADSENSE_SLOT_LEARN=
# Actual operator legal identity and privacy contact; configure before public launch.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=

# Private Vercel Blob store for 24h report exports; without it local tmp is used.
BLOB_READ_WRITE_TOKEN=
# Optional Vercel preview deployment protection bypass (server-side only).
VERCEL_AUTOMATION_BYPASS_SECRET=

# B-05 server-only AI follow-up switch; SiteConfig feature.llmChat can override it.
FEATURE_LLM_CHAT=false
# MiniMax secret API key; never expose through NEXT_PUBLIC_*.
MINIMAX_API_KEY=
# Verified for the Owner account: international returned 401, China endpoint /models returned 200.
# International accounts may use https://api.minimax.io/v1 instead.
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# M2.5: 204800 context, standard $0.30/$1.20 per million input/output tokens.
# Tied lowest M2 price; cached input $0.03/M (official pricing checked 2026-10-05).
MINIMAX_MODEL=MiniMax-M2.5

# Platform override: Workers detects Cloudflare; Node uses the local SQLite development path.
PLATFORM=
# Cloudflare CLI/WAF credentials; only CF_ANALYTICS_TOKEN is bound to the Worker.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Cloudflare uses EXPORT_BUCKET (private R2), BROWSER and ASSETS bindings in wrangler.toml.
# Runtime secrets go into `wrangler secret put NAME`; local secrets into apps/web/.dev.vars.
# Apply D1 SQL with wrangler d1 migrations apply destinyos --local / --remote.

# Same API token stored as a Worker secret, with Account Analytics Read permission.
CF_ANALYTICS_TOKEN=
# Account-wide Workers allowance; all scripts count toward the same limits.
CF_ANALYTICS_ACCOUNT_ID=9aea83b326d8175abdd136c1177637a5
# UTC billing anniversary day from the Owner invoice (1-31; short months clamp).
CF_BILLING_CYCLE_DAY=1

# M-09 mobile OAuth audiences (comma-separated platform client IDs); Apple native defaults to pub.gavin.tianji.
MOBILE_GOOGLE_CLIENT_IDS=
MOBILE_APPLE_CLIENT_IDS=
# Ed25519 raw public key (base64url); private PEM is used ONLY by scripts/mobile-knowledge-release.ts, never by the Worker.
MOBILE_KNOWLEDGE_PUBLIC_KEY=
MOBILE_KNOWLEDGE_KEY_ID=v1
# Optional exact Authorization header configured in the RevenueCat dashboard; both checks required if HMAC secret is also set.
REVENUECAT_WEBHOOK_AUTHORIZATION=
# Android Play App Signing certificate SHA-256 fingerprints (comma-separated); public certificates only.
MOBILE_ANDROID_CERT_SHA256=
