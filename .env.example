# PostgreSQL pooled connection; local Docker credentials are for development only.
DATABASE_URL=postgresql://tianji:tianji_local@localhost:5432/tianji
# Direct PostgreSQL connection used by Prisma migrations.
DIRECT_DATABASE_URL=postgresql://tianji:tianji_local@localhost:5432/tianji
# Local Redis; production can use the Upstash REST variables instead.
REDIS_URL=redis://localhost:6379
# Upstash Redis REST endpoint (production).
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST authentication token (server only).
UPSTASH_REDIS_REST_TOKEN=
# Auth.js signing secret; generate with openssl rand -base64 32.
AUTH_SECRET=
# Google OAuth client ID.
AUTH_GOOGLE_ID=
# Google OAuth client secret.
AUTH_GOOGLE_SECRET=
# Resend API key for magic-link mail.
RESEND_API_KEY=
# Verified sender address used by Resend.
EMAIL_FROM=
# AES-256-GCM keys: v2:<base64 32-byte key>,v1:<old key>; first key writes.
FIELD_ENCRYPTION_KEYS=
# Stripe secret API key (server only).
STRIPE_SECRET_KEY=
# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Stripe monthly subscription price ID.
STRIPE_PRICE_MONTHLY=
# Stripe yearly subscription price ID.
STRIPE_PRICE_YEARLY=
# Public AdSense publisher ID, e.g. ca-pub-xxxx.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Canonical public production URL; use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://tianji.gavin.pub
# Default language; supported initial locales are zh and en.
NEXT_PUBLIC_DEFAULT_LOCALE=zh
# Reserved runtime LLM polish switch; remains disabled.
FEATURE_LLM_POLISH=false
# Advertisement feature switch (ads integration ships in M4).
FEATURE_ADS=true
# Comma-separated administrator email allowlist (server only).
ADMIN_EMAILS=
# Optional Sentry DSN for monitoring.
SENTRY_DSN=
# Server-only Vercel Cron authentication secret.
CRON_SECRET=
