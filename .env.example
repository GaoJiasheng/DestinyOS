# PostgreSQL pooled connection; local Docker credentials are for development only.
DATABASE_URL=postgresql://tianji:tianji_local@localhost:5432/tianji
# Direct PostgreSQL connection used by Prisma migrations.
DIRECT_DATABASE_URL=postgresql://tianji:tianji_local@localhost:5432/tianji
# Local Redis; production can use the Upstash REST variables instead.
REDIS_URL=redis://localhost:6379
# Upstash Redis REST endpoint (production).
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST authentication token (server only).
UPSTASH_REDIS_REST_TOKEN=
# Auth.js signing secret; generate with openssl rand -base64 32.
AUTH_SECRET=
# Canonical Auth.js origin; Preview uses its isolated deployment URL.
AUTH_URL=https://tianji.gavin.pub
# Only deploy behind the trusted Vercel proxy.
AUTH_TRUST_HOST=true
# Google OAuth client ID.
AUTH_GOOGLE_ID=
# Google OAuth client secret.
AUTH_GOOGLE_SECRET=
# Resend API key for magic-link mail.
RESEND_API_KEY=
# Verified sender address used by Resend.
EMAIL_FROM=
# AES-256-GCM keys: v2:<base64 32-byte key>,v1:<old key>; first key writes.
FIELD_ENCRYPTION_KEYS=
# Stripe secret API key (server only).
STRIPE_SECRET_KEY=
# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Stripe monthly subscription price ID.
STRIPE_PRICE_MONTHLY=
# Stripe yearly subscription price ID.
STRIPE_PRICE_YEARLY=
# Public AdSense publisher ID, e.g. ca-pub-xxxx.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Canonical public production URL; use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://tianji.gavin.pub
# Default language; supported initial locales are zh and en.
NEXT_PUBLIC_DEFAULT_LOCALE=zh
# Reserved runtime LLM polish switch; remains disabled.
FEATURE_LLM_POLISH=false
# Advertisement feature switch (ads integration ships in M4).
FEATURE_ADS=true
# Comma-separated administrator email allowlist (server only).
ADMIN_EMAILS=
# Optional Sentry DSN for monitoring.
SENTRY_DSN=
# Server-only Vercel Cron authentication secret.
CRON_SECRET=

# Optional public browser monitoring DSN (never a server secret).
NEXT_PUBLIC_SENTRY_DSN=

# Enable automatic tax only after activating Stripe Tax in the merchant account.
STRIPE_TAX_ENABLED=false
# Optional product creation prices in USD cents (defaults 299 and 2499).
STRIPE_MONTHLY_CENTS=299
STRIPE_YEARLY_CENTS=2499
# Numeric AdSense slot IDs from the publisher account; absent IDs omit their slots.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_REPORT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_REPORT_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_TODAY=
NEXT_PUBLIC_ADSENSE_SLOT_LEARN=
# Actual operator legal identity and privacy contact; configure before public launch.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=

# B-05 server-only AI follow-up switch; SiteConfig feature.llmChat can override it.
FEATURE_LLM_CHAT=false
# MiniMax secret API key; never expose through NEXT_PUBLIC_*.
MINIMAX_API_KEY=
# Verified for the Owner account: international returned 401, China endpoint /models returned 200.
# International accounts may use https://api.minimax.io/v1 instead.
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# M2.5: 204800 context, standard $0.30/$1.20 per million input/output tokens.
# Tied lowest M2 price; cached input $0.03/M (official pricing checked 2026-10-05).
MINIMAX_MODEL=MiniMax-M2.5
