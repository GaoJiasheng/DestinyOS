{
  "name": "destiny-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm content:build && pnpm worker:build && turbo run build",
    "lint": "pnpm content:validate && eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "turbo run typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "test": "pnpm content:build && vitest run --coverage && pnpm --filter @tianji/mobile test",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "format": "prettier --write .",
    "test:e2e": "playwright test && pnpm test:auth:e2e && pnpm test:readings:e2e && pnpm test:bazi:e2e && pnpm test:ziwei:e2e && pnpm test:divination:e2e && pnpm test:tarot:e2e && pnpm test:astrology:e2e && pnpm test:home:e2e && pnpm test:daily-account:e2e && pnpm test:m4:e2e && pnpm test:m5:e2e && pnpm test:polish && pnpm test:export:e2e && pnpm test:chat:e2e && pnpm test:numerology:e2e && pnpm test:rectification:e2e && pnpm test:calendar:e2e && pnpm test:zhtw:e2e && pnpm test:synastry:e2e && pnpm test:seo-content:e2e && pnpm test:journal:e2e",
    "content:validate": "pnpm --filter @tianji/content validate",
    "content:build": "pnpm --filter @tianji/content content:build && pnpm i18n:traditional",
    "engine:bundle": "tsx scripts/engines/bundle.ts",
    "content:qimen:coverage": "pnpm --filter @tianji/content coverage:qimen",
    "content:tarot:coverage": "pnpm --filter @tianji/content coverage:tarot",
    "content:astrology:coverage": "pnpm --filter @tianji/content coverage:astrology",
    "db:generate": "prisma generate && tsx scripts/prisma-metadata.ts",
    "db:migrate": "pnpm --filter @tianji/web exec wrangler d1 migrations apply destinyos --local",
    "db:deploy": "tsx scripts/sqlite-migrate.ts",
    "postinstall": "prisma generate && tsx scripts/prisma-metadata.ts",
    "test:auth:e2e": "playwright test --config playwright.auth.config.ts",
    "content:daily:coverage": "pnpm --filter @tianji/content coverage:daily",
    "geo:build": "tsx scripts/geo-preprocess.ts",
    "test:readings:e2e": "playwright test --config playwright.readings.config.ts",
    "test:bazi:e2e": "playwright test --config playwright.bazi.config.ts",
    "test:ziwei:e2e": "pnpm build && playwright test --config playwright.ziwei.config.ts",
    "test:divination:e2e": "pnpm build && playwright test --config playwright.divination.config.ts",
    "tarot:assets": "tsx scripts/tarot-assets.ts",
    "test:tarot:e2e": "pnpm build && playwright test --config playwright.tarot.config.ts",
    "test:astrology:e2e": "playwright test --config playwright.astrology.config.ts",
    "stars:build": "tsx scripts/stars-preprocess.ts",
    "fonts:build": "pnpm i18n:traditional && python3 scripts/font-subsets.py && python3 scripts/font-traditional-subsets.py",
    "pwa:assets": "pnpm --filter @tianji/web exec tsx scripts/pwa-assets.ts",
    "test:home:e2e": "pnpm build && playwright test --config playwright.home.config.ts",
    "perf:ci": "pnpm build && pnpm perf:budgets && playwright test --config playwright.daily-account.config.ts --grep \"anonymous example\" && tsx scripts/perf-run.ts",
    "perf:budgets": "tsx scripts/perf-budgets.ts",
    "fonts:og": "python3 scripts/og-font-subset.py",
    "test:daily-account:e2e": "playwright test --config playwright.daily-account.config.ts",
    "stripe:products": "tsx scripts/stripe-products.ts",
    "licenses:check": "tsx scripts/license-check.ts",
    "security:policy": "tsx scripts/security-policy.ts",
    "test:m4:e2e": "playwright test --config playwright.m4.config.ts",
    "test:m5:e2e": "playwright test --config playwright.m5.config.ts",
    "launch:check": "pnpm content:build && tsx scripts/launch-check.ts",
    "content:import": "pnpm content:build && tsx scripts/content-import.ts",
    "worker:build": "tsx scripts/daily-worker-build.ts",
    "polish:content": "pnpm content:build && tsx scripts/polish-content-audit.ts",
    "test:polish": "NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000 NEXT_PUBLIC_ADSENSE_SLOT_HOME=1000000001 NEXT_PUBLIC_ADSENSE_SLOT_REPORT_TOP=1000000002 NEXT_PUBLIC_ADSENSE_SLOT_REPORT_BOTTOM=1000000003 NEXT_PUBLIC_ADSENSE_SLOT_TODAY=1000000004 NEXT_PUBLIC_ADSENSE_SLOT_LEARN=1000000005 pnpm build && pnpm fonts:check && pnpm perf:budgets && tsx scripts/polish-content-audit.ts && playwright test --config playwright.polish.config.ts",
    "test:export:e2e": "playwright test --config playwright.export.config.ts",
    "test:chat:e2e": "playwright test --config playwright.chat.config.ts",
    "test:numerology:e2e": "pnpm build && playwright test --config playwright.numerology.config.ts",
    "test:rectification:e2e": "pnpm build && playwright test --config playwright.rectification.config.ts",
    "test:calendar:e2e": "playwright test --config playwright.calendar.config.ts",
    "i18n:traditional": "tsx scripts/i18n-traditional.ts",
    "test:zhtw:e2e": "playwright test --config playwright.zhtw.config.ts",
    "test:synastry:e2e": "playwright test --config playwright.synastry.config.ts",
    "cf:build": "pnpm --filter @tianji/web cf:build",
    "cf:preview": "pnpm --filter @tianji/web cf:preview",
    "cf:deploy": "pnpm --filter @tianji/web cf:deploy",
    "test:cloudflare:e2e": "playwright test --config playwright.cloudflare.config.ts",
    "test:seo-content:e2e": "playwright test --config playwright.seo-content.config.ts",
    "chat:eval": "pnpm content:build && tsx scripts/chat-eval-batch.ts run && tsx scripts/chat-eval-batch.ts judge && tsx scripts/chat-eval-batch.ts summary",
    "chat:eval:individual": "pnpm content:build && tsx scripts/chat-eval.ts baseline && tsx scripts/chat-eval.ts run && tsx scripts/chat-eval.ts retry && tsx scripts/chat-eval.ts deliver && tsx scripts/chat-eval.ts judge && tsx scripts/chat-eval.ts summary",
    "test:journal:e2e": "playwright test --config playwright.journal.config.ts",
    "fonts:check": "pnpm i18n:traditional && python3 scripts/font-coverage.py",
    "db:remote": "pnpm --filter @tianji/web exec wrangler d1 migrations apply destinyos --remote",
    "cf:smoke": "tsx scripts/cloudflare-smoke.ts",
    "mobile:fonts": "python3 apps/mobile/scripts/font-subsets.py",
    "test:web-nopay:e2e": "playwright test --config playwright.web-nopay.config.ts",
    "perf:ttfb": "tsx scripts/perf-ttfb.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.0",
    "@formatjs/icu-messageformat-parser": "^2.11.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.0",
    "@prisma/client": "6.19.3",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/license-checker": "^25.0.6",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fflate": "^0.8.2",
    "jsdom": "^26",
    "jsonrepair": "^3.15.0",
    "jsqr": "^1.4.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "liuyao": "0.5.1",
    "prettier": "^3.6.2",
    "prisma": "^6",
    "qimen-dunjia": "3.1.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1",
    "zod": "^3.25.76",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/adapter-better-sqlite3": "6.19.3",
    "better-sqlite3": "^12.4.1",
    "@types/better-sqlite3": "^7.6.13",
    "miniflare": "4.20260730.0"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "tmp": "^0.2.6",
      "uuid@<11.1.1": "^11.1.1",
      "@auth/core": "^0.41.3",
      "deepmerge-ts": "^8.0.0",
      "sharp": "^0.35.4",
      "basic-ftp": "^6.2.1",
      "react-native-worklets": "0.10.1",
      "@react-native/metro-config": "0.86.3",
      "react-native": "0.86.3",
      "@types/react": "~19.2.4",
      "@types/react-dom": "~19.2.0",
      "react-native-reanimated": "4.5.1",
      "react-native-gesture-handler": "~2.32.0"
    },
    "patchedDependencies": {
      "extract-zip@2.0.1": "patches/extract-zip@2.0.1.patch"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-40299",
        "CVE-2026-56876",
        "CVE-2026-19693"
      ],
      "ignoreGhsas": [
        "GHSA-4c35-wcg5-mm9h"
      ]
    }
  }
}
