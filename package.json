{
  "name": "destiny-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm content:build && turbo run build",
    "lint": "pnpm content:validate && eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "turbo run typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "format": "prettier --write .",
    "test:e2e": "playwright test && pnpm test:auth:e2e",
    "content:validate": "pnpm --filter @tianji/content validate",
    "content:build": "pnpm --filter @tianji/content content:build",
    "engine:bundle": "tsx scripts/engines/bundle.ts",
    "content:qimen:coverage": "pnpm --filter @tianji/content coverage:qimen",
    "content:tarot:coverage": "pnpm --filter @tianji/content coverage:tarot",
    "content:astrology:coverage": "pnpm --filter @tianji/content coverage:astrology",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:auth:e2e": "playwright test --config playwright.auth.config.ts",
    "content:daily:coverage": "pnpm --filter @tianji/content coverage:daily"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "^9.39.0",
    "@formatjs/icu-messageformat-parser": "^2.11.0",
    "@playwright/test": "^1.56.0",
    "@prisma/client": "6.19.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ioredis-mock": "^8.13.1",
    "liuyao": "0.5.1",
    "prettier": "^3.6.2",
    "prisma": "^6",
    "qimen-dunjia": "3.1.0",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "yaml": "^2.9.1",
    "zod": "^3.25.76",
    "ioredis": "^5.11.1",
    "@types/ioredis-mock": "^8.2.8"
  },
  "type": "module"
}
