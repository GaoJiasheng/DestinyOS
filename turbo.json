{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_DEFAULT_LOCALE",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_ADSENSE_*",
        "FEATURE_ADS",
        "PRIVACY_CONTROLLER_NAME",
        "PRIVACY_CONTACT_EMAIL",
        "PLATFORM"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@tianji/mobile#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "../web/messages/**"]
    }
  },
  "globalPassThroughEnv": [
    "AUTH_*",
    "ADMIN_EMAILS",
    "EMAIL_FROM",
    "EMAIL_FROM_NAME",
    "TEST_WEB_MODE",
    "FIELD_ENCRYPTION_KEYS",
    "SENTRY_DSN",
    "TEST_MAIL_URL",
    "STRIPE_*",
    "CRON_SECRET",
    "MINIMAX_*",
    "FEATURE_LLM_CHAT",
    "LOCAL_DATABASE_URL",
    "PLATFORM",
    "REVENUECAT_*"
  ],
  "globalDependencies": ["prisma/schema.prisma", "apps/web/migrations/**", "apps/web/messages/**"]
}
