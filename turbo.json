{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_SITE_URL", "NEXT_PUBLIC_DEFAULT_LOCALE", "NEXT_PUBLIC_SENTRY_DSN"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "REDIS_URL",
    "UPSTASH_REDIS_REST_*",
    "AUTH_*",
    "ADMIN_EMAILS",
    "EMAIL_FROM",
    "RESEND_API_KEY",
    "FIELD_ENCRYPTION_KEYS",
    "SENTRY_DSN",
    "TEST_MAIL_URL"
  ],
  "globalDependencies": ["prisma/schema.prisma", "prisma/migrations/**"]
}
