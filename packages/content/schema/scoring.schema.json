{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tianji.gavin.pub/schema/scoring.schema.json",
  "definitions": {
    "dim": { "enum": ["career", "wealth", "love", "health", "social"] },
    "text": { "type": "string", "minLength": 1 },
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "$ref": "#/definitions/text" },
        "en": { "$ref": "#/definitions/text" }
      }
    },
    "negative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en", "advice"],
      "properties": {
        "zh": { "$ref": "#/definitions/text" },
        "en": { "$ref": "#/definitions/text" },
        "advice": { "$ref": "#/definitions/bilingual" }
      }
    },
    "number": { "type": "number" },
    "source": { "enum": ["self", "opposite"] },
    "brightness": { "enum": ["miao", "wang", "de", "li", "ping", "bu", "xian"] },
    "starKey": { "type": "string", "pattern": "^[a-z][a-z_]*$" },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["2", "3", "4", "5"],
      "properties": {
        "2": { "$ref": "#/definitions/bilingual" },
        "3": { "$ref": "#/definitions/bilingual" },
        "4": { "$ref": "#/definitions/bilingual" },
        "5": { "$ref": "#/definitions/bilingual" }
      }
    },
    "measure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "factor"],
          "properties": {
            "kind": { "const": "brightness" },
            "from": { "$ref": "#/definitions/source" },
            "factor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "deltas"],
          "properties": {
            "kind": { "const": "mutagen" },
            "from": { "$ref": "#/definitions/source" },
            "deltas": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "lu": { "$ref": "#/definitions/number" },
                "quan": { "$ref": "#/definitions/number" },
                "ke": { "$ref": "#/definitions/number" },
                "ji": { "$ref": "#/definitions/number" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "keys"],
          "oneOf": [{ "required": ["each"] }, { "required": ["once"] }],
          "properties": {
            "kind": { "const": "stars" },
            "from": { "$ref": "#/definitions/source" },
            "keys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/starKey" }
            },
            "brightness": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/brightness" }
            },
            "each": { "$ref": "#/definitions/number" },
            "once": { "$ref": "#/definitions/number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "all", "any", "delta"],
          "properties": {
            "kind": { "const": "combo" },
            "from": { "$ref": "#/definitions/source" },
            "all": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/starKey" }
            },
            "any": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?:[a-z][a-z_]*|mutagen:(?:lu|quan|ke|ji))$"
              }
            },
            "delta": { "$ref": "#/definitions/number" }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "reliability", "note", "measure", "copy"],
      "properties": {
        "id": { "type": "string", "pattern": "^zw\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)*$" },
        "code": { "$ref": "#/definitions/text" },
        "reliability": { "enum": ["consensus", "school_split", "weak"] },
        "note": { "$ref": "#/definitions/text" },
        "dims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/dim" }
        },
        "gate": { "enum": ["occupied", "empty"] },
        "group": { "type": "string", "pattern": "^[a-z_]+$" },
        "measure": { "$ref": "#/definitions/measure" },
        "copy": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "positive": { "$ref": "#/definitions/bilingual" },
            "zero": { "$ref": "#/definitions/bilingual" },
            "negative": { "$ref": "#/definitions/negative" }
          }
        }
      }
    },
    "dimCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "inline"],
      "properties": {
        "label": { "$ref": "#/definitions/bilingual" },
        "inline": { "$ref": "#/definitions/bilingual" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scoringVersion",
    "system",
    "dims",
    "omitted",
    "palaceOf",
    "clamp",
    "cutpoints",
    "calibration",
    "brightnessScale",
    "groups",
    "rules",
    "copy"
  ],
  "properties": {
    "scoringVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "system": { "const": "ziwei" },
    "dims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/dim" }
    },
    "omitted": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/dim" } },
    "palaceOf": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "$ref": "#/definitions/dim" },
      "patternProperties": { "": { "type": "string", "pattern": "^[a-z]+$" } }
    },
    "clamp": { "type": "number", "exclusiveMinimum": 0 },
    "cutpoints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/definitions/number" }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample", "seed", "years", "now", "cities", "quantiles", "correlationNote"],
      "properties": {
        "sample": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" },
        "years": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer" }
        },
        "now": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "cities": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
        "quantiles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
        },
        "correlationNote": { "$ref": "#/definitions/text" }
      }
    },
    "brightnessScale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["miao", "wang", "de", "li", "ping", "bu", "xian"],
      "patternProperties": { "": { "$ref": "#/definitions/number" } }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cap"],
        "properties": { "cap": { "$ref": "#/definitions/number" } }
      }
    },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/rule" } },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "levels", "dims", "sentences", "overview", "footnotes"],
      "properties": {
        "title": { "$ref": "#/definitions/bilingual" },
        "levels": { "$ref": "#/definitions/levels" },
        "dims": { "type": "object", "additionalProperties": { "$ref": "#/definitions/dimCopy" } },
        "sentences": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/levels" }
        },
        "overview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["two", "one", "none"],
          "properties": {
            "two": { "$ref": "#/definitions/bilingual" },
            "one": { "$ref": "#/definitions/bilingual" },
            "none": { "$ref": "#/definitions/bilingual" }
          }
        },
        "footnotes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disclaimer", "health", "crossSystem", "brightness"],
          "properties": {
            "disclaimer": { "$ref": "#/definitions/bilingual" },
            "health": { "$ref": "#/definitions/bilingual" },
            "crossSystem": { "$ref": "#/definitions/bilingual" },
            "brightness": { "$ref": "#/definitions/bilingual" }
          }
        }
      }
    }
  }
}
