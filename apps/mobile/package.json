{
  "name": "@tianji/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --platform ios --platform android",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "test:e2e": "bash scripts/maestro.sh"
  },
  "dependencies": {
    "expo": "57.0.27",
    "@tianji/shared": "workspace:*",
    "@tianji/engine": "workspace:*",
    "@tianji/interpret": "workspace:*",
    "@tianji/content": "workspace:*",
    "@tianji/ui-core": "workspace:*",
    "i18next": "^25.6.0",
    "i18next-icu": "^2.4.0",
    "react-i18next": "^16.0.0",
    "zustand": "^5.0.0",
    "expo-router": "~57.0.25",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-font": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "expo-linking": "~57.0.12",
    "expo-constants": "~57.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-dev-client": "~57.0.19",
    "react-dom": "19.2.3",
    "react-native-worklets": "0.10.1",
    "expo-system-ui": "~57.0.4",
    "react-native-reanimated": "4.5.1",
    "react-native-gesture-handler": "~2.32.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/react": "~19.2.4",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "@testing-library/react-native": "^13.3.3",
    "react-test-renderer": "19.2.3",
    "@react-native/metro-config": "0.86.3",
    "@types/react-dom": "~19.2.0",
    "babel-preset-expo": "~57.0.14"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
